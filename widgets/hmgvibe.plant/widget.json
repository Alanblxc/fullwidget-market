{
  "id": "hmgvibe.plant",
  "name": { "zh-TW": "桌面小植物", "zh-CN": "桌面小植物", "en": "Desk plant" },
  "description": {
    "zh-TW": "一盆放在桌面上的小植物。每天澆一次水它就長大一點，忘了澆會垂頭喪氣，再澆就好了。",
    "zh-CN": "一盆放在桌面上的小植物。每天浇一次水它就长大一点，忘了浇会垂头丧气，再浇就好了。",
    "en": "A little plant on your desktop. Water it once a day and it grows a bit; forget and it droops, until you water it again."
  },
  "version": "1.0.0",
  "author": "hmgvibe",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "other",
  "preview": "preview/{theme}.{lang}.webp",
