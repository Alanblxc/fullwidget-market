        { "value": "leafy", "label": { "zh-TW": "綠植", "zh-CN": "绿植", "en": "Leafy" } },
        { "value": "sunflower", "label": { "zh-TW": "向日葵", "zh-CN": "向日葵", "en": "Sunflower" } },
        { "value": "cactus", "label": { "zh-TW": "仙人掌", "zh-CN": "仙人掌", "en": "Cactus" } }
      ] },
    { "key": "name", "type": "text", "label": { "zh-TW": "名字", "zh-CN": "名字", "en": "Name" }, "default": { "zh-TW": "小綠", "zh-CN": "小绿", "en": "Sprout" } }
  ]
