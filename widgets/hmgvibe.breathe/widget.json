        { "value": "2", "label": { "zh-TW": "2 分鐘", "zh-CN": "2 分钟", "en": "2 minutes" } },
        { "value": "5", "label": { "zh-TW": "5 分鐘", "zh-CN": "5 分钟", "en": "5 minutes" } }
      ] }
  ]
